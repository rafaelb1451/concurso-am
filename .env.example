# Copie para .env no servidor e preencha. NUNCA comite o .env.
#
# ATENCAO: este arquivo e' a base do PRIMEIRO deploy. Em atualizacoes, o
# scripts/deploy.sh le o .env existente e aborta se faltar segredo — ele nao
# regrava o arquivo. Nunca rode `cat > .env` em producao sem backup.
#
# Valores com `$`, `#` ou espacos precisam de aspas simples. Senhas geradas com
# `openssl rand -base64 24` nao tem `$` e sao seguras para o Compose.

# ------------------------------------------------------------------ domínio (OBRIGATÓRIO)
# Com domínio próprio, aponte o registro A para o IP da VM:
DOMINIO=qb.seudominio.com.br
# Sem domínio, use o IP nesta forma (o sslip.io resolve e emite cert válido):
# DOMINIO=qb.203.0.113.10.sslip.io

# ------------------------------------------------------------------ banco (PostgreSQL) — OBRIGATÓRIO
# Gere uma senha forte:  openssl rand -base64 24
POSTGRES_DB=qb
POSTGRES_USER=qb
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# tamanho do pool de conexões da aplicação (12 serve bem até algumas centenas de usuários)
DB_POOL_SIZE=12

# Schema versionado por Flyway (backend/src/main/resources/db/migration).
# validate = o Hibernate só confere as entidades contra o schema migrado
DDL_AUTO=validate
FLYWAY_ENABLED=true

# ------------------------------------------------------------------ pagamento (Mercado Pago)
# Access Token da aplicacao (painel do Mercado Pago > Suas integracoes > Credenciais)
# OBRIGATORIO: sem ele o checkout responde "Pagamento indisponivel" e ninguem compra.
MP_ACCESS_TOKEN=
# Assinatura secreta configurada no painel do MP (Webhooks > Assinatura secreta).
# OBRIGATORIA: sem ela o webhook e' recusado (fail closed) e o pagamento aprovado
# nao libera o PRO. O HMAC x-signature e' a unica prova de autenticidade.
MP_WEBHOOK_SECRET=

# ------------------------------------------------------------------ pagamento (PagBank) — GATEWAY ATIVO
# Token da conta PagBank (iBanking > Integracoes > Token de acesso).
# Sandbox: https://sandbox.api.pagseguro.com | Producao: https://api.pagseguro.com
PAGBANK_TOKEN=
PAGBANK_BASE_URL=https://api.pagseguro.com
PAGBANK_WEBHOOK_URL=https://qbconcurso.com.br/api/webhooks/pagbank

# Legado: nao e' mais usado pelo Mercado Pago (mantido apenas para o Asaas).
MP_WEBHOOK_TOKEN=
# URL publica de notificacao (sem token na query string):
MP_NOTIFICATION_URL=https://SEU-DOMINIO/api/webhooks/mercadopago
# URL do webhook a cadastrar no painel:
#   https://SEU-DOMINIO/api/webhooks/mercadopago

# ------------------------------------------------------------------ IA
# Chave da DeepSeek (rotacione no console se suspeitar de vazamento)
DEEPSEEK_API_KEY=sk-...

# ------------------------------------------------------------------ e-mail transacional (SMTP UOL)
# Servidor SMTP do e-mail profissional (UOL Suite/Host). Porta 587 + STARTTLS (padrao) ou 465 + SSL.
SMTP_HOST=smtp.suite.uol
SMTP_PORT=587
# Se SMTP_USERNAME estiver preenchido, SMTP_PASSWORD tambem precisa estar: sem ela
# o cadastro falha no envio do e-mail de verificacao (erro 503).
SMTP_USERNAME=contato@qbconcurso.com.br
SMTP_PASSWORD=TROQUE_PELA_SENHA_DO_EMAIL
SMTP_FROM=contato@qbconcurso.com.br
SMTP_STARTTLS=true
SMTP_SSL=false
# OBRIGATORIO ser https (o Mercado Pago recusa back_urls http)
CONCURSO_APP_URL=https://qb.seudominio.com.br
# Origem usada em canonical/sitemap das paginas publicas de SEO
SEO_BASE_URL=https://qbconcurso.com.br

# ------------------------------------------------------------------ pagamento (Asaas)
# Chave da API: painel Asaas > Integracoes > Chave de API
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3  |  Producao: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token definido no webhook do Asaas (header asaas-access-token). Sem ele o webhook recusa tudo.
ASAAS_WEBHOOK_TOKEN=
