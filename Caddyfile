{
	# força o Let's Encrypt de produção (sem staging)
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# QB Concurso — porta de entrada única.
#
# HTTPS automático (Let's Encrypt) + cabeçalhos de segurança. O login é feito pelo próprio app.
# O app roda sem porta publicada: só é alcançável por aqui.

{$DOMINIO} {
	encode zstd gzip


	header {
		# impede sniffing de tipo de conteúdo
		X-Content-Type-Options "nosniff"
		# não vaza a URL de origem para terceiros
		Referrer-Policy "strict-origin-when-cross-origin"
		# não permite ser embutido em iframe de outro site
		X-Frame-Options "DENY"
		# desliga APIs de dispositivo que o app não usa
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# HSTS por um ano (só faz sentido com HTTPS válido, que é o caso)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# política de conteúdo: scripts da própria origem; fontes do Google
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# nenhum caminho especial: tudo vai para o Spring (que serve o SPA e a API)
	reverse_proxy app:8080 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
		format json
	}
}

# www -> domínio principal
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
